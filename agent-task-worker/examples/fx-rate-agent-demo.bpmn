<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn" id="Definitions_FxRateAgentDemo" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fluxnova Modeler" exporterVersion="1.3.1-dev">
  <bpmn:process id="fx-rate-agent-demo" name="FX Rate Agent Demo" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_ToAgentTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="AgentTask_1" name="FX + Time Agent">
      <bpmn:extensionElements>
        <fluxnova:properties>
          <fluxnova:property name="activeTasksCollection" value="OrchestratorTask" />
        </fluxnova:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAgentTask</bpmn:incoming>
      <bpmn:outgoing>Flow_FromAgentTask</bpmn:outgoing>
      <bpmn:serviceTask id="OrchestratorTask" name="Agent LLM Call" camunda:modelerTemplate="org.fluxnova.example.AgentTaskLlmCall" camunda:type="external" camunda:topic="agent-task">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="prompt">What time is it right now in Tokyo, and what would 250 USD be worth in EUR?</camunda:inputParameter>
            <camunda:inputParameter name="systemPrompt">You are a helpful assistant that can answer currency conversion questions and timezone/time questions. Use the get_rate tool for currency questions and the get_current_time/convert_time tools for time questions - always call the right tool before stating a number or a time, never guess. If a question only needs one of your tools, only call that one. Show your reasoning briefly, then give a clear final answer.</camunda:inputParameter>
            <camunda:inputParameter name="model">gpt-4.1-mini</camunda:inputParameter>
            <camunda:inputParameter name="maxTokens">1024</camunda:inputParameter>
            <camunda:inputParameter name="outputVariable">agentResponse</camunda:inputParameter>
            <camunda:inputParameter name="maxIterations">6</camunda:inputParameter>
            <camunda:inputParameter name="memoryWindowSize">0</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="FxRateTool" name="FX Rate MCP" camunda:modelerTemplate="org.fluxnova.example.AgentToolMcp" camunda:type="external" camunda:topic="agent-tool">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="toolKind">mcp</camunda:inputParameter>
            <camunda:inputParameter name="mcpServerName">fxrate</camunda:inputParameter>
            <camunda:inputParameter name="mcpTransport">stdio</camunda:inputParameter>
            <camunda:inputParameter name="mcpCommand">node</camunda:inputParameter>
            <camunda:inputParameter name="mcpArgs">examples/fx-rate-mcp-server.js</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="TimeTool" name="Time MCP" camunda:modelerTemplate="org.fluxnova.example.AgentToolMcp" camunda:type="external" camunda:topic="agent-tool">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="toolKind">mcp</camunda:inputParameter>
            <camunda:inputParameter name="mcpServerName">time</camunda:inputParameter>
            <camunda:inputParameter name="mcpTransport">stdio</camunda:inputParameter>
            <camunda:inputParameter name="mcpCommand">uvx</camunda:inputParameter>
            <camunda:inputParameter name="mcpArgs">mcp-server-time</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_FromAgentTask</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAgentTask" sourceRef="StartEvent_1" targetRef="AgentTask_1" />
    <bpmn:sequenceFlow id="Flow_FromAgentTask" sourceRef="AgentTask_1" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="fx-rate-agent-demo">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="162" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="892" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentTask_1_di" bpmnElement="AgentTask_1" isExpanded="true">
        <dc:Bounds x="240" y="80" width="620" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrchestratorTask_di" bpmnElement="OrchestratorTask">
        <dc:Bounds x="280" y="150" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FxRateTool_di" bpmnElement="FxRateTool">
        <dc:Bounds x="460" y="150" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TimeTool_di" bpmnElement="TimeTool">
        <dc:Bounds x="640" y="150" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToAgentTask_di" bpmnElement="Flow_ToAgentTask">
        <di:waypoint x="198" y="190" />
        <di:waypoint x="240" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromAgentTask_di" bpmnElement="Flow_FromAgentTask">
        <di:waypoint x="860" y="190" />
        <di:waypoint x="892" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>